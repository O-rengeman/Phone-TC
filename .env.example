# このファイルを .env にコピーして値を埋めてください（.env は Git に含まれません）。
# Copy this file to .env and fill in the values (.env is git-ignored).

# --- sakura_proxy.py -------------------------------------------------------
# さくらのAI APIキー。未設定の場合、プロキシは起動時にエラーを表示して終了します。
SAKURA_API_KEY=

# --- 自前のTURNサーバー (任意 / optional) ----------------------------------
# 企業内Wi-FiやSymmetric NAT環境でP2P接続が失敗する場合に設定します。
# 未設定なら従来どおり公開STUN/TURN（Open Relay Project）のみを使用します。
# 複数指定する場合はカンマ区切り。
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
